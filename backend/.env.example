# Copy to backend/.env and fill in. Only the email settings are described here.

# Link used in emails (reset-password, "View application" buttons).
FRONTEND_URL=http://localhost:5173
# Timezone for dates shown in emails.
APP_TIMEZONE=Asia/Karachi

# ---- Email (free, real delivery via Gmail SMTP, ~500 emails/day) ----
# 1. Use a Gmail account (a new one like xchango.notify@gmail.com is best).
# 2. Turn on 2-Step Verification: https://myaccount.google.com/security
# 3. Create an App Password: https://myaccount.google.com/apppasswords
#    (name it "Xchango", copy the 16-character password, no spaces).
# 4. Put the Gmail address and App Password below and restart the backend.
# Leave SMTP_USER/SMTP_PASS empty to disable emails (in-app notifications still work).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional display name/address shown to recipients.
EMAIL_FROM="Xchango <your.gmail@gmail.com>"
