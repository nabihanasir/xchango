# Copy to backend/.env and fill in. Only the email settings are described here.

# Link used in emails (reset-password, "View application" buttons).
FRONTEND_URL=http://localhost:5173
# Timezone for dates shown in emails.
APP_TIMEZONE=Asia/Karachi

# ---- Email (free, real delivery via Gmail SMTP, ~500 emails/day) ----
# 1. Use a Gmail account (a new one like xchango.notify@gmail.com is best).
# 2. Turn on 2-Step Verification: https://myaccount.google.com/security
# 3. Create an App Password: https://myaccount.google.com/apppasswords
#    (name it "Xchango", copy the 16-character password, no spaces).
# 4. Put the Gmail address and App Password below and restart the backend.
# Leave SMTP_USER/SMTP_PASS empty to disable emails (in-app notifications still work).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional display name/address shown to recipients.
EMAIL_FROM="Xchango <your.gmail@gmail.com>"

# ---- Local model for course matching (optional, free) ----
# Course matching tries this Ollama model first and falls back to the hosted models (Gemini, ...) if Ollama
# is not running or fails. Transcripts, outlines and the FAQ chat never use it.
# 1. Install Ollama, then: ollama pull gemma4:e4b-it-qat
# 2. Set OLLAMA_MODEL below and restart the backend. Leave it empty to skip Ollama.
OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434
# Milliseconds to wait for one answer (a laptop CPU needs minutes). Default 300000.
# OLLAMA_TIMEOUT_MS=300000
# Context window in tokens. Matching prompts can be several thousand tokens. Default 8192.
# OLLAMA_NUM_CTX=8192

# Gemini 2.5 "thinks" before answering, which can take 25+ seconds. The app switches that off (reasoning_effort
# none). Set to "default" to turn the model's own thinking back on.
# GEMINI_REASONING_EFFORT=none
